<!-- Humanoid Boxing's world: a square ring with three ropes a side, and two
     Unitree G1s (boxing_g1.xml) attached as red_ and blue_, facing each other
     across the centre. Body names are the seam to the scene, so they're frozen:
     world, then red_pelvis … red_right_wrist_yaw_link, then blue_ likewise.

     Scale: the G1 stands 1.32 m, three quarters of a person, so the ring is
     4.6 m between the ropes (a 6.1 m ring scaled down) and the ropes sit at
     0.3, 0.6 and 0.9 m. The canvas is the plane; a knockdown is anything but a
     foot touching it. The ropes are soft so a fighter can lean into them. -->
<mujoco model="boxing">
  <compiler angle="radian" discardvisual="true"/>
  <!-- The G1 MJX model's own settings (its <option> is ignored on attach): a 4 ms
       step, implicitfast, no Euler damping. Fixed iterations bound the worst
       case step time. -->
  <option timestep="0.004" integrator="implicitfast" iterations="20" ls_iterations="20">
    <flag eulerdamp="disable"/>
  </option>

  <asset>
    <model name="g1" file="boxing_g1.xml"/>
  </asset>

  <default>
    <default class="ring">
      <geom contype="1" conaffinity="1" condim="3" friction="1 0.005 0.0001" rgba="0.85 0.85 0.8 1"/>
      <default class="rope">
        <geom type="capsule" size="0.02" solref="0.03 1" priority="1" rgba="0.9 0.2 0.2 1"/>
      </default>
      <default class="post">
        <geom type="cylinder" size="0.05 0.55" pos="0 0 0.55" rgba="0.3 0.3 0.35 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1"/>
    <geom name="canvas" class="ring" type="plane" size="5 5 0.1"/>

    <!-- Four posts, 2.3 m from the centre along each axis, and three ropes a side. -->
    <geom name="post_ne" class="post" pos="2.3 2.3 0"/>
    <geom name="post_nw" class="post" pos="-2.3 2.3 0"/>
    <geom name="post_se" class="post" pos="2.3 -2.3 0"/>
    <geom name="post_sw" class="post" pos="-2.3 -2.3 0"/>
    <geom name="rope_n_1" class="rope" fromto="-2.3 2.3 0.3 2.3 2.3 0.3"/>
    <geom name="rope_n_2" class="rope" fromto="-2.3 2.3 0.6 2.3 2.3 0.6"/>
    <geom name="rope_n_3" class="rope" fromto="-2.3 2.3 0.9 2.3 2.3 0.9"/>
    <geom name="rope_s_1" class="rope" fromto="-2.3 -2.3 0.3 2.3 -2.3 0.3"/>
    <geom name="rope_s_2" class="rope" fromto="-2.3 -2.3 0.6 2.3 -2.3 0.6"/>
    <geom name="rope_s_3" class="rope" fromto="-2.3 -2.3 0.9 2.3 -2.3 0.9"/>
    <geom name="rope_e_1" class="rope" fromto="2.3 -2.3 0.3 2.3 2.3 0.3"/>
    <geom name="rope_e_2" class="rope" fromto="2.3 -2.3 0.6 2.3 2.3 0.6"/>
    <geom name="rope_e_3" class="rope" fromto="2.3 -2.3 0.9 2.3 2.3 0.9"/>
    <geom name="rope_w_1" class="rope" fromto="-2.3 -2.3 0.3 -2.3 2.3 0.3"/>
    <geom name="rope_w_2" class="rope" fromto="-2.3 -2.3 0.6 -2.3 2.3 0.6"/>
    <geom name="rope_w_3" class="rope" fromto="-2.3 -2.3 0.9 -2.3 2.3 0.9"/>

    <!-- Red starts west of centre facing east; blue mirrors it. They start at
         touching-gloves distance, 0.6 m pelvis to pelvis: in reach of a punch
         without a step, since balance and walking are the bots' problems. -->
    <frame name="red_corner" pos="-0.3 0 0">
      <attach model="g1" body="pelvis" prefix="red_"/>
    </frame>
    <frame name="blue_corner" pos="0.3 0 0" quat="0 0 0 1">
      <attach model="g1" body="pelvis" prefix="blue_"/>
    </frame>
  </worldbody>

  <!-- The start: both fighters in the G1's "home" stance (knees slightly bent,
       arms at the sides), 0.6 m apart, facing each other. Every qpos and ctrl. -->
  <keyframe>
    <key name="start"
      qpos="-0.3 0 0.783675 1 0 0 0 -0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0 0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0  0.3 0 0.783675 0 0 0 1 -0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0 0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0"
      ctrl="-0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0 0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0  -0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0 0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0"/>
  </keyframe>
</mujoco>
